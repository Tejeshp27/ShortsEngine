# =============================================================
# .gitignore — files git should never track
# =============================================================

# --- Secrets ---
# NEVER commit .env — it holds real API keys
.env

# --- Python ---
# Virtual environment (each developer creates their own)
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# --- Generated output (can be re-created by running the pipeline) ---
output/
cache/

# --- Downloaded AI model files (large, re-downloadable) ---
# Kokoro TTS model (~310 MB) and Whisper model (auto-cached by faster-whisper)
models/

# --- Database (contains real video data; each environment has its own) ---
shortsengine.db
# The Docker setup keeps the database in data/ instead.
data/

# --- macOS system files ---
.DS_Store

# --- Editor files ---
.vscode/
.idea/
*.swp

# --- Streamer permission screenshots (private DMs; keep them, never commit them) ---
permissions/

# Creator-supplied media is private and can be very large.
/recordings/
