# =============================================================
# .env.example — required environment variables
#
# Copy this file to .env and fill in your real values.
# NEVER commit .env — it is listed in .gitignore.
# =============================================================

# ---- Anthropic (required for Phase 1+) ----
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ---- Instagram (required for Phase 4 publishing) ----
# See PROMPTS.md Phase 4.1 for setup steps.
INSTAGRAM_ACCESS_TOKEN=your-instagram-access-token
INSTAGRAM_ACCOUNT_ID=your-instagram-account-id

# ---- TikTok (required for Phase 4 publishing) ----
# See PROMPTS.md Phase 4.3 for setup steps.
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
TIKTOK_ACCESS_TOKEN=your-tiktok-access-token-after-oauth

# Register this exact callback in your approved TikTok developer app.
# Use the dashboard's eventual HTTPS address when connecting real accounts.
TIKTOK_REDIRECT_URI=https://your-dashboard.example/oauth/tiktok/callback

# Instagram uses Facebook Login for professional accounts linked to a Page.
# These belong to your Meta developer app; app review/scopes must be approved.
META_APP_ID=your-meta-app-id
# Keep the app secret private; the server exchanges authorization codes with it.
META_APP_SECRET=your-meta-app-secret
# Register this exact callback URI in the Meta developer app's login settings.
INSTAGRAM_REDIRECT_URI=https://your-dashboard.example/oauth/instagram/callback
# Supported Meta Graph API version; update deliberately when migrating versions.
META_GRAPH_VERSION=v24.0

# ---- Pexels (optional — enables stock photos AND video B-roll) ----
# Free API key at https://www.pexels.com/api/
# Without this key, the pipeline tries Pixabay next, then Wikimedia.
PEXELS_API_KEY=your-pexels-api-key-here

# ---- Pixabay (optional — free fallback for photos AND video B-roll) ----
# Free API key at https://pixabay.com/api/docs/ (instant, no approval wait).
# Used automatically when Pexels returns no results or PEXELS_API_KEY is not set.
# No attribution required; commercial use allowed.
PIXABAY_API_KEY=your-pixabay-api-key-here

# ---- ElevenLabs (optional — best-quality voiceovers) ----
# API key at https://elevenlabs.io — free tier gives 10,000 chars/month.
# Starter plan ~$5/mo → 30,000 chars (~50 videos). Best quality available.
# Set tts_provider = "elevenlabs" and elevenlabs_voice = "Rachel" in channels/news.yaml.
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here

# ---- NewsAPI (optional — trending headlines from 80k+ sources) ----
# Free API key at https://newsapi.org — 100 requests/day on the free tier.
# Adds a "newsapi" source type to channel configs alongside RSS feeds, and
# powers the dashboard's topic search together with GDELT (which needs no key).
# The free plan is for development only; check its terms before commercial use.
NEWS_API_KEY=your-newsapi-key-here

# ---- Freesound (optional — hook sound effects) ----
# Free API key at https://freesound.org/apiv2/apply — sign up and create an app.
# Adds a punchy sound effect at the start of each video to hook viewers.
FREESOUND_API_KEY=your-freesound-api-key-here

# ---- Stability AI (optional — AI-generated images as a visual fallback) ----
# API key at https://platform.stability.ai — free credits to start, then ~$0.03/image.
# Used when Pexels, Pixabay, and Wikimedia all fail to find a matching image.
STABILITY_API_KEY=your-stability-api-key-here

# ---- Mubert (optional — background music generation) ----
# Free API tier at https://mubert.com/api (sign up with your email).
# Used when you pass --music to generate a royalty-free background track.
# Both the API key AND the email you registered with are required.
MUBERT_API_KEY=your-mubert-api-key-here
MUBERT_EMAIL=your-mubert-registration-email@example.com

# ---- Twitch (required for Phase 6.4 Twitch channel) ----
# Get credentials at https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=your-twitch-client-id
TWITCH_CLIENT_SECRET=your-twitch-client-secret

# ---- Dashboard (required to run the web dashboard) ----
# SESSION_SECRET signs the login cookie so nobody can forge one. It must be
# at least 32 random characters. The easiest way to get one is to run
#   python -m src.dashboard.set_password
# which creates your login AND adds a SESSION_SECRET to .env if it is missing
# (on your own computer; on a Docker server, see docs/deploy.md).
# Changing this value logs everyone out.
SESSION_SECRET=replace-with-at-least-32-random-characters

# Your dashboard password is NOT stored here. It is saved, hashed, in the
# database by `python -m src.dashboard.set_password`.

# Set to true on a server that uses HTTPS, so the login cookie is never sent
# over an unencrypted connection. Leave false for http://localhost.
SESSION_COOKIE_SECURE=false

# Optional dedicated Fernet key for stored account tokens. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If omitted, encryption derives from SESSION_SECRET. In that case changing
# SESSION_SECRET requires reconnecting accounts. Back up this key with the DB.
# ACCOUNT_TOKEN_KEY=your-generated-fernet-key

# Collect missing daily account/post statistics while the dashboard is running.
# No publishing occurs; disconnected accounts make no platform requests.
DASHBOARD_AUTO_COLLECT=true

# Which network address the dashboard listens on. 127.0.0.1 = this computer
# only (other devices on your Wi-Fi cannot reach it). Docker sets its own value.
DASHBOARD_HOST=127.0.0.1

# Where the database file is kept. Leave unset to use shortsengine.db in the
# project folder. Docker sets this to a folder that survives rebuilds.
# DATABASE_PATH=shortsengine.db
